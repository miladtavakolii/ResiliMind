# ==========================================
# ResiliMind Environment Configuration
# ==========================================

# LLM & Provider Settings
# Supported providers: 'ollama', 'gemini', 'openai', 'anthropic'
RESILIMIND_LLM_PROVIDER=ollama
RESILIMIND_LLM_MODEL=gemma4:e2b
RESILIMIND_LLM_API_KEY=
RESILIMIND_LLM_BASE_URL=http://localhost:11434
RESILIMIND_LLM_TEMPERATURE=0.6

# Logging Configuration
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Relative paths will automatically be resolved inside the DATA_DIR directory
LOG_FILE_PATH=logs/resilimind.log

# Centralized Storage Directory
DATA_DIR=data

# Evaluation & Benchmark Settings
# (Optional: falls back to RESILIMIND_LLM_* if left unset)
RESILIMIND_EVAL_PROVIDER=gemini
RESILIMIND_EVAL_MODEL=gemini-2.5-flash
RESILIMIND_EVAL_API_KEY=
RESILIMIND_EVAL_BASE_URL=

# workflow configs
RESILIMIND_ROUTING_CONFIDENCE_THRESHOLD=0.70
